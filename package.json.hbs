{
  "name": "{{projectName}}",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "vp run --filter web dev",
    "build": "vp run --filter web build",
    "typegen": "vp run --filter web typegen",
    "typecheck": "vp run -r typecheck",
    "lint": "vp run -r lint"
  },
  "devDependencies": {
    "@template/config": "workspace:*",
    "typescript": "^6.0.3",
    "vite-plus": "0.2.6"
  },
  "packageManager": "bun@1.3.14"
}
